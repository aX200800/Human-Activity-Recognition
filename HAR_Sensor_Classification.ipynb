    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# ✅ MVP TRAINING: 5-Class Activity Recognition (A,B,C,D,E)\n",
        "# ============================================================\n",
        "# This block is COPY-PASTE READY.\n",
        "# It repeats the same \"grouped windowing + CNN training\" pipeline,\n",
        "# but uses accel_mvp (only A,B,C,D,E) instead of accel_df.\n",
        "#\n",
        "# WHY MVP?\n",
        "# - Phone accelerometer is great for locomotion + posture (walking/jogging/stairs/sitting/standing)\n",
        "# - Fine-grained daily actions (eating, writing, etc.) are much harder with accel-only\n",
        "# - This MVP gives a strong, realistic model while staying low-power and cost-effective.\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "\n",
        "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "\n",
        "tf.random.set_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 0: Filter dataset to MVP classes (A,B,C,D,E)\n",
        "# ============================================================\n",
        "KEEP = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
        "accel_mvp = accel_df[accel_df[\"activity\"].isin(KEEP)].copy()\n",
        "\n",
        "print(\"✅ accel_mvp rows:\", accel_mvp.shape[0])\n",
        "print(\"✅ activities:\\n\", accel_mvp[\"activity\"].value_counts())\n",
        "print(\"✅ subjects:\", accel_mvp[\"subject\"].nunique())\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 1: SETTINGS (good accuracy but still efficient)\n",
        "# ============================================================\n",
        "WINDOW_SIZE = 128      # more context helps separate walking vs stairs etc.\n",
        "STRIDE = 64            # overlap improves accuracy (still reasonable compute)\n",
        "EPOCHS = 20\n",
        "BATCH_SIZE = 128\n",
        "\n",
        "# Purity is not needed when we window within (subject, activity),\n",
        "# but we keep the segment-splitting logic to handle timestamp gaps.\n",
        "# (So windows remain continuous and clean.)\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 2: SUBJECT-INDEPENDENT SPLIT (realistic evaluation)\n",
        "# ============================================================\n",
        "subjects = np.sort(accel_mvp[\"subject\"].unique())\n",
        "np.random.shuffle(subjects)\n",
        "\n",
        "split = int(0.8 * len(subjects))\n",
        "train_subjects = subjects[:split]\n",
        "test_subjects  = subjects[split:]\n",
        "\n",
        "print(\"Train subjects:\", len(train_subjects), \"Test subjects:\", len(test_subjects))\n",
        "\n",
        "train_df = accel_mvp[accel_mvp[\"subject\"].isin(train_subjects)].copy()\n",
        "test_df  = accel_mvp[accel_mvp[\"subject\"].isin(test_subjects)].copy()\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 3: Estimate sampling gap and define segment-break threshold\n",
        "# ============================================================\n",
        "# WISDM is ~20Hz, so expected dt ~50ms (but units may differ).\n",
        "# We compute a median dt and define a \"gap threshold\" as 10x that.\n",
        "# Any larger jump is treated as a new segment.\n",
        "\n",
        "sample = train_df.sort_values(\"timestamp\").head(5000)\n",
        "dt = sample[\"timestamp\"].diff().dropna()\n",
        "typical_dt = dt.median()\n",
        "gap_threshold = typical_dt * 10\n",
        "\n",
        "print(\"Typical dt:\", typical_dt, \"| Gap threshold:\", gap_threshold)\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 4: Windowing WITHOUT mixing activities\n",
        "# ============================================================\n",
        "# What we do:\n",
        "# - group by (subject, activity)\n",
        "# - sort by timestamp\n",
        "# - split into segments if a large time gap occurs\n",
        "# - create fixed windows within each segment\n",
        "#\n",
        "# Extra channels (cheap but useful):\n",
        "# - magnitude (acc_mag)\n",
        "# - jerk (difference in magnitude)\n",
        "\n",
        "def make_windows_grouped(df, window_size=128, stride=64):\n",
        "    X_list, y_list = [], []\n",
        "\n",
        "    for (s, act), g in df.groupby([\"subject\", \"activity\"]):\n",
        "        g = g.sort_values(\"timestamp\").reset_index(drop=True)\n",
        "\n",
        "        # Segment split if timestamp jumps\n",
        "        jumps = g[\"timestamp\"].diff().fillna(0) > gap_threshold\n",
        "        seg_id = jumps.cumsum()\n",
        "\n",
        "        for _, seg in g.groupby(seg_id):\n",
        "            seg = seg.reset_index(drop=True)\n",
        "            n = len(seg)\n",
        "            if n < window_size:\n",
        "                continue\n",
        "\n",
        "            ax = seg[\"ax\"].to_numpy(np.float32)\n",
        "            ay = seg[\"ay\"].to_numpy(np.float32)\n",
        "            az = seg[\"az\"].to_numpy(np.float32)\n",
        "\n",
        "            acc_mag = np.sqrt(ax*ax + ay*ay + az*az).astype(np.float32)\n",
        "            jerk = np.diff(acc_mag, prepend=acc_mag[0]).astype(np.float32)\n",
        "\n",
        "            data = np.stack([ax, ay, az, acc_mag, jerk], axis=1)  # shape (T, 5)\n",
        "\n",
        "            for start in range(0, n - window_size + 1, stride):\n",
        "                X_list.append(data[start:start+window_size])\n",
        "                y_list.append(act)\n",
        "\n",
        "    X = np.stack(X_list) if len(X_list) else np.empty((0, window_size, 5), dtype=np.float32)\n",
        "    y = np.array(y_list)\n",
        "    return X, y\n",
        "\n",
        "X_train, y_train = make_windows_grouped(train_df, WINDOW_SIZE, STRIDE)\n",
        "X_test,  y_test  = make_windows_grouped(test_df,  WINDOW_SIZE, STRIDE)\n",
        "\n",
        "print(\"Train windows:\", X_train.shape, \"Test windows:\", X_test.shape)\n",
        "print(\"Train label counts:\\n\", pd.Series(y_train).value_counts())\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 5: Label encoding (train-only) + Standardization\n",
        "# ============================================================\n",
        "classes = np.unique(y_train)\n",
        "cls2id = {c:i for i,c in enumerate(classes)}\n",
        "id2cls = {i:c for c,i in cls2id.items()}\n",
        "\n",
        "y_train_id = np.array([cls2id[v] for v in y_train], dtype=np.int32)\n",
        "y_test_id  = np.array([cls2id[v] for v in y_test], dtype=np.int32)\n",
        "\n",
        "print(\"Classes used:\", classes)\n",
        "\n",
        "# Normalize using training statistics\n",
        "mean = X_train.mean(axis=(0,1), keepdims=True)\n",
        "std  = X_train.std(axis=(0,1), keepdims=True) + 1e-8\n",
        "\n",
        "X_train_n = (X_train - mean) / std\n",
        "X_test_n  = (X_test  - mean) / std\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 6: Class weights (handles imbalance)\n",
        "# ============================================================\n",
        "cw = compute_class_weight(\"balanced\", classes=np.arange(len(classes)), y=y_train_id)\n",
        "class_weights = {i: float(w) for i, w in enumerate(cw)}\n",
        "print(\"Using class weights:\", class_weights)\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 7: Small but Strong CNN (mobile-friendly)\n",
        "# ============================================================\n",
        "# Efficiency choices:\n",
        "# - SeparableConv1D reduces compute vs standard Conv1D\n",
        "# - GlobalAveragePooling avoids big Dense layers\n",
        "# - Moderate filter sizes for better accuracy than the ultra-tiny model\n",
        "\n",
        "def build_small_cnn(input_shape, num_classes):\n",
        "    inputs = tf.keras.Input(shape=input_shape)\n",
        "\n",
        "    x = tf.keras.layers.Conv1D(24, 7, padding=\"same\")(inputs)\n",
        "    x = tf.keras.layers.BatchNormalization()(x)\n",
        "    x = tf.keras.layers.ReLU()(x)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(48, 5, padding=\"same\")(x)\n",
        "    x = tf.keras.layers.BatchNormalization()(x)\n",
        "    x = tf.keras.layers.ReLU()(x)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(64, 3, padding=\"same\")(x)\n",
        "    x = tf.keras.layers.BatchNormalization()(x)\n",
        "    x = tf.keras.layers.ReLU()(x)\n",
        "\n",
        "    x = tf.keras.layers.GlobalAveragePooling1D()(x)\n",
        "    x = tf.keras.layers.Dropout(0.25)(x)\n",
        "\n",
        "    outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)\n",
        "\n",
        "    model = tf.keras.Model(inputs, outputs)\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n",
        "\n",
        "model = build_small_cnn((WINDOW_SIZE, X_train_n.shape[2]), len(classes))\n",
        "model.summary()\n",
        "print(\"Params:\", model.count_params())\n",
        "\n",
        "callbacks = [\n",
        "    tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=4, restore_best_weights=True),\n",
        "    tf.keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=2, min_lr=1e-5)\n",
        "]\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 8: Train\n",
        "# ============================================================\n",
        "history = model.fit(\n",
        "    X_train_n, y_train_id,\n",
        "    validation_split=0.15,\n",
        "    epochs=EPOCHS,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    class_weight=class_weights,\n",
        "    callbacks=callbacks,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# ✅ STEP 9: Evaluate\n",
        "# ============================================================\n",
        "probs = model.predict(X_test_n, verbose=0)\n",
        "pred_id = np.argmax(probs, axis=1)\n",
        "y_pred = np.array([id2cls[i] for i in pred_id])\n",
        "\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "f1m = f1_score(y_test, y_pred, average=\"macro\")\n",
        "\n",
        "print(\"\\n===== MVP Test Results (Subject-independent) =====\")\n",
        "print(\"Accuracy:\", acc)\n",
        "print(\"Macro-F1 :\", f1m)\n",
        "print(\"\\nReport:\\n\", classification_report(y_test, y_pred))\n"
      ],
      "metadata": {
