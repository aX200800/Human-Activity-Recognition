      "cell_type": "markdown",
      "source": [
        "ptional: Low-cost GRU (cheaper “LSTM-like”)\n",
        "\n",
        "If you want a sequence model but still power-aware:"
      ],
      "metadata": {
        "id": "5P0IyhxG2zIc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def build_tiny_gru_low_cost(input_shape, num_classes):\n",
        "    \"\"\"\n",
        "    Low-cost GRU model:\n",
        "    - GRU is typically cheaper than LSTM for similar performance\n",
        "    - Small hidden sizes reduce compute\n",
        "    \"\"\"\n",
        "    inputs = tf.keras.Input(shape=input_shape)\n",
        "\n",
        "    x = tf.keras.layers.GRU(24, return_sequences=True)(inputs)\n",
        "    x = tf.keras.layers.GRU(12)(x)\n",
        "\n",
        "    x = tf.keras.layers.Dropout(0.2)(x)\n",
        "    outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)\n",
        "\n",
        "    model = tf.keras.Model(inputs, outputs)\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n"
      ],
