        "    \"G\": \"Brushing Teeth\",\n",
        "    \"H\": \"Eating Soup\",\n",
        "    \"I\": \"Eating Chips\",\n",
        "    \"J\": \"Eating Pasta\",\n",
        "    \"K\": \"Drinking (Cup)\",\n",
        "    \"L\": \"Eating Sandwich\",\n",
        "    \"M\": \"Kicking (Soccer Ball)\",\n",
        "    \"O\": \"Playing Catch (Tennis Ball)\",\n",
        "    \"P\": \"Dribbling (Basketball)\",\n",
        "    \"Q\": \"Writing\",\n",
        "    \"R\": \"Clapping\",\n",
        "    \"S\": \"Folding Clothes\",\n",
        "}\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 1: Run predictions on test set\n",
        "# ------------------------------------------------------------\n",
        "probs = model.predict(X_test_n, verbose=0)      # (N, num_classes)\n",
        "pred_id = np.argmax(probs, axis=1)\n",
        "conf = np.max(probs, axis=1)\n",
        "top2_id = np.argsort(probs, axis=1)[:, -2:]    # top-2 ids\n",
        "\n",
        "# true code -> id\n",
        "cls2id = {c:i for i,c in enumerate(classes)}\n",
        "y_true_id = np.array([cls2id[v] for v in y_test], dtype=int)\n",
        "\n",
        "# pred id -> code\n",
        "y_pred_codes = np.array([id2cls[i] for i in pred_id])\n",
        "\n",
        "# codes -> names\n",
        "y_true_names = np.array([ACTIVITY_NAME.get(c, c) for c in y_test])\n",
        "y_pred_names = np.array([ACTIVITY_NAME.get(c, c) for c in y_pred_codes])\n",
        "\n",
        "correct = (pred_id == y_true_id)\n",
        "\n",
        "print(\"Test windows:\", len(y_test))\n",
        "print(\"Accuracy:\", correct.mean())\n",
        "print(\"Macro-F1:\", f1_score(y_true_names, y_pred_names, average=\"macro\"))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 1: Confidence histogram (overall)\n",
        "# ------------------------------------------------------------\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.hist(conf, bins=30)\n",
        "plt.title(\"Confidence Distribution (All Test Predictions) - 18 classes\")\n",
        "plt.xlabel(\"Predicted confidence (max softmax probability)\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 2: Confidence histogram (Correct vs Wrong)\n",
        "# ------------------------------------------------------------\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.hist(conf[correct], bins=30, alpha=0.7, label=\"Correct\")\n",
        "plt.hist(conf[~correct], bins=30, alpha=0.7, label=\"Wrong\")\n",
        "plt.title(\"Confidence Distribution: Correct vs Wrong - 18 classes\")\n",
        "plt.xlabel(\"Predicted confidence\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 3: Accuracy vs Confidence bins\n",
        "# ------------------------------------------------------------\n",
        "bins = np.linspace(0, 1, 11)\n",
        "bin_ids = np.digitize(conf, bins) - 1\n",
        "\n",
        "bin_acc, bin_conf = [], []\n",
        "for b in range(len(bins)-1):\n",
        "    mask = (bin_ids == b)\n",
        "    if mask.sum() == 0:\n",
        "        continue\n",
        "    bin_acc.append(correct[mask].mean())\n",
        "    bin_conf.append(conf[mask].mean())\n",
        "\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.plot(bin_conf, bin_acc, marker=\"o\")\n",
        "plt.plot([0,1], [0,1], linestyle=\"--\")\n",
        "plt.title(\"Accuracy vs Confidence Bins (Calibration-style) - 18 classes\")\n",
        "plt.xlabel(\"Mean confidence in bin\")\n",
        "plt.ylabel(\"Accuracy in bin\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 4: Reliability diagram (Expected Calibration Curve)\n",
        "# ------------------------------------------------------------\n",
        "frac_pos, mean_pred = calibration_curve(correct.astype(int), conf, n_bins=10, strategy=\"uniform\")\n",
        "\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.plot(mean_pred, frac_pos, marker=\"o\", label=\"Model\")\n",
        "plt.plot([0,1], [0,1], linestyle=\"--\", label=\"Perfect calibration\")\n",
        "plt.title(\"Reliability Diagram (Calibration Curve) - 18 classes\")\n",
        "plt.xlabel(\"Mean predicted confidence\")\n",
        "plt.ylabel(\"Fraction correct\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 5: Confusion Matrix (Normalized) with Activity Names (18x18)\n",
        "# ------------------------------------------------------------\n",
        "# Use labels in a consistent order:\n",
        "# - Prefer the order in your training \"classes\"\n",
        "# - Fall back to ACTIVITY_NAME keys if needed\n",
        "labels_codes = list(classes)  # keep training order\n",
        "labels_names = [ACTIVITY_NAME.get(c, c) for c in labels_codes]\n",
        "\n",
        "cm = confusion_matrix(y_true_names, y_pred_names, labels=labels_names)\n",
        "cm_norm = cm / (cm.sum(axis=1, keepdims=True) + 1e-9)\n",
        "\n",
        "plt.figure(figsize=(11,9))\n",
        "plt.imshow(cm_norm)\n",
        "plt.title(\"Normalized Confusion Matrix (18 Activities)\")\n",
        "plt.xticks(range(len(labels_names)), labels_names, rotation=60, ha=\"right\")\n",
        "plt.yticks(range(len(labels_names)), labels_names)\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"True\")\n",
        "plt.colorbar()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 6: Per-class F1 bar chart (18 activities)\n",
        "# ------------------------------------------------------------\n",
        "prec, rec, f1s, sup = precision_recall_fscore_support(\n",
        "    y_true_names, y_pred_names, labels=labels_names, zero_division=0\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(11,4))\n",
        "plt.bar(labels_names, f1s)\n",
        "plt.title(\"Per-class F1 Score (18 Activities)\")\n",
        "plt.xlabel(\"Activity\")\n",
        "plt.ylabel(\"F1\")\n",
        "plt.xticks(rotation=60, ha=\"right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Metric: Top-2 Accuracy\n",
        "# ------------------------------------------------------------\n",
        "top2_correct = np.array([y_true_id[i] in top2_id[i] for i in range(len(y_true_id))])\n",
        "print(\"Top-1 Accuracy:\", correct.mean())\n",
        "print(\"Top-2 Accuracy:\", top2_correct.mean())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Plot 7: Accuracy with 95% Confidence Intervals vs Confidence Bins\n",
        "# ------------------------------------------------------------\n",
        "def wilson_ci(k, n, z=1.96):\n",
        "    if n == 0:\n",
        "        return (np.nan, np.nan)\n",
        "    p = k / n\n",
        "    denom = 1 + z*z/n\n",
        "    center = (p + z*z/(2*n)) / denom\n",
        "    margin = (z * np.sqrt((p*(1-p)/n) + (z*z/(4*n*n)))) / denom\n",
        "    return center - margin, center + margin\n",
        "\n",
        "bin_centers, bin_acc2, bin_low, bin_high = [], [], [], []\n",
        "for b in range(len(bins)-1):\n",
        "    mask = (bin_ids == b)\n",
        "    n = mask.sum()\n",
        "    if n == 0:\n",
        "        continue\n",
        "    k = correct[mask].sum()\n",
        "    acc_b = k / n\n",
        "    lo, hi = wilson_ci(k, n)\n",
        "\n",
        "    center_conf = (bins[b] + bins[b+1]) / 2\n",
        "    bin_centers.append(center_conf)\n",
        "    bin_acc2.append(acc_b)\n",
        "    bin_low.append(lo)\n",
        "    bin_high.append(hi)\n",
        "\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.plot(bin_centers, bin_acc2, marker=\"o\", label=\"Accuracy per bin\")\n",
        "plt.fill_between(bin_centers, bin_low, bin_high, alpha=0.2, label=\"95% CI (Wilson)\")\n",
        "plt.title(\"Accuracy with 95% CI vs Confidence Bins - 18 classes\")\n",
        "plt.xlabel(\"Confidence bin center\")\n",
        "plt.ylabel(\"Accuracy\")\n",
        "plt.ylim(0, 1)\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Optional: bin counts\n",
        "plt.figure(figsize=(7,3))\n",
        "plt.bar([f\"{bins[i]:.1f}-{bins[i+1]:.1f}\" for i in range(len(bins)-1)],\n",
        "        [(bin_ids == i).sum() for i in range(len(bins)-1)])\n",
        "plt.title(\"Number of Samples per Confidence Bin - 18 classes\")\n",
        "plt.xlabel(\"Confidence bin\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.xticks(rotation=45, ha=\"right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
