    {
      "cell_type": "code",
      "source": [
        "def build_tiny_cnn(input_shape, num_classes):\n",
        "    inputs = tf.keras.Input(shape=input_shape)\n",
        "\n",
        "    x = tf.keras.layers.Conv1D(16, 7, padding=\"same\", activation=\"relu\")(inputs)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    # depthwise-separable conv = fewer multiplications (power-friendly)\n",
        "    x = tf.keras.layers.SeparableConv1D(32, 5, padding=\"same\", activation=\"relu\")(x)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(64, 3, padding=\"same\", activation=\"relu\")(x)\n",
        "\n",
        "    # GlobalAveragePooling avoids large Dense layers (big power saver)\n",
        "    x = tf.keras.layers.GlobalAveragePooling1D()(x)\n",
        "\n",
        "    x = tf.keras.layers.Dropout(0.2)(x)\n",
        "    outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)\n",
        "\n",
        "    model = tf.keras.Model(inputs, outputs)\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n"
      ],
      "metadata": {
        "id": "VZVbZXDdoEUP"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Tiny GRU (use instead of LSTM to save power)\n",
        "\n",
        "GRU is usually cheaper than LSTM with similar performance."
      ],
      "metadata": {
        "id": "jALTXNOxoHfg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def build_tiny_gru(input_shape, num_classes):\n",
        "    inputs = tf.keras.Input(shape=input_shape)\n",
        "\n",
        "    x = tf.keras.layers.GRU(32, return_sequences=True)(inputs)\n",
        "    x = tf.keras.layers.GRU(16)(x)\n",
        "\n",
        "    x = tf.keras.layers.Dropout(0.2)(x)\n",
        "    outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)\n",
        "\n",
        "    model = tf.keras.Model(inputs, outputs)\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n"
      ],
      "metadata": {
        "id": "SvgeiswnoHyQ"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Training loop with GroupKFold (subject-independent)\n",
        "\n",
        "This reports Accuracy + Macro-F1 per fold and overall."
      ],
      "metadata": {
        "id": "3P3aFGzGoKVj"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def standardize_train_test(X_train, X_test):\n",
        "    # Normalize per channel using training statistics (power-neutral, improves stability)\n",
        "    mean = X_train.mean(axis=(0,1), keepdims=True)\n",
        "    std = X_train.std(axis=(0,1), keepdims=True) + 1e-8\n",
        "    return (X_train - mean)/std, (X_test - mean)/std\n",
        "\n",
        "def make_tf_dataset(X, y, batch_size=128, training=True):\n",
        "    ds = tf.data.Dataset.from_tensor_slices((X, y))\n",
        "    if training:\n",
        "        ds = ds.shuffle(min(len(X), 5000), reshuffle_each_iteration=True)\n",
        "    ds = ds.batch(batch_size).prefetch(tf.data.AUTOTUNE)\n",
        "    return ds\n",
        "\n",
        "def run_cv_model(df, build_fn, window_size=128, stride=64, purity=0.8, epochs=15, batch_size=128):\n",
        "    subjects = np.sort(df[\"subject\"].unique())\n",
        "    gkf = GroupKFold(n_splits=5)\n",
        "\n",
        "    all_true, all_pred = [], []\n",
        "    fold_rows = []\n",
        "\n",
        "    for fold, (tr_idx, te_idx) in enumerate(gkf.split(subjects, groups=subjects), start=1):\n",
        "        train_subjects = subjects[tr_idx]\n",
        "        test_subjects  = subjects[te_idx]\n",
        "\n",
        "        X_train, y_train, _ = window_all_subjects(df, train_subjects, window_size, stride, purity)\n",
        "        X_test,  y_test,  _ = window_all_subjects(df, test_subjects,  window_size, stride, purity)\n",
        "\n",
        "        # fit label encoder on TRAIN labels only (safe)\n",
        "        classes, cls2id, id2cls = fit_label_encoder(y_train)\n",
        "        y_train_id = encode_labels(y_train, cls2id)\n",
        "        y_test_id  = encode_labels(y_test, cls2id)\n",
        "\n",
        "        # standardize\n",
        "        X_train, X_test = standardize_train_test(X_train, X_test)\n",
        "\n",
        "        num_classes = len(classes)\n",
        "        input_shape = (window_size, 3)\n",
        "\n",
        "        model = build_fn(input_shape, num_classes)\n",
        "\n",
        "        callbacks = [\n",
        "            tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=3, restore_best_weights=True)\n",
        "        ]\n",
        "\n",
        "        # simple validation split from training windows\n",
        "        val_split = int(0.85 * len(X_train))\n",
        "        X_tr, y_tr = X_train[:val_split], y_train_id[:val_split]\n",
        "        X_va, y_va = X_train[val_split:], y_train_id[val_split:]\n",
        "\n",
        "        ds_tr = make_tf_dataset(X_tr, y_tr, batch_size=batch_size, training=True)\n",
        "        ds_va = make_tf_dataset(X_va, y_va, batch_size=batch_size, training=False)\n",
        "        ds_te = make_tf_dataset(X_test, y_test_id, batch_size=batch_size, training=False)\n",
        "\n",
        "        hist = model.fit(ds_tr, validation_data=ds_va, epochs=epochs, verbose=1, callbacks=callbacks)\n",
        "\n",
        "        probs = model.predict(ds_te, verbose=0)\n",
        "        pred_id = np.argmax(probs, axis=1)\n",
        "\n",
        "        # decode back to activity codes for reporting consistency\n",
        "        pred = np.array([classes[i] for i in pred_id])\n",
        "        true = y_test\n",
        "\n",
        "        acc = accuracy_score(true, pred)\n",
        "        f1m = f1_score(true, pred, average=\"macro\")\n",
        "\n",
        "        print(f\"\\nFold {fold} | windows train={len(y_train)} test={len(y_test)} | Acc={acc:.4f} Macro-F1={f1m:.4f}\")\n",
        "        fold_rows.append((fold, acc, f1m, model.count_params()))\n",
        "\n",
        "        all_true.append(true)\n",
        "        all_pred.append(pred)\n",
        "\n",
        "    y_true = np.concatenate(all_true)\n",
        "    y_pred = np.concatenate(all_pred)\n",
        "\n",
        "    overall_acc = accuracy_score(y_true, y_pred)\n",
        "    overall_f1m = f1_score(y_true, y_pred, average=\"macro\")\n",
        "\n",
        "    print(\"\\n===== Overall =====\")\n",
        "    print(\"Accuracy:\", overall_acc)\n",
        "    print(\"Macro-F1 :\", overall_f1m)\n",
        "    print(\"\\nReport:\\n\", classification_report(y_true, y_pred))\n",
        "\n",
        "    return pd.DataFrame(fold_rows, columns=[\"fold\",\"accuracy\",\"macro_f1\",\"params\"]), (y_true, y_pred)\n"
      ],
