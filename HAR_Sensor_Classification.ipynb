    {
      "cell_type": "markdown",
      "source": [
        "Low-cost / low-power design choices:\n",
        "1) Smaller window size (64 samples ≈ 3.2s @ 20Hz):\n",
        "   - reduces inference latency and computations per prediction\n",
        "   - may reduce accuracy because less context is available\n",
        "\n",
        "2) No-overlap windowing (stride = window size):\n",
        "   - fewer windows => faster training and lower total compute\n",
        "   - reduces redundancy but may slightly reduce performance\n",
        "\n",
        "3) Smaller CNN (filters 8→16→32 instead of 16→32→64):\n",
        "   - fewer parameters and multiplications => lower power use on mobile CPU\n",
        "   - slight accuracy drop expected vs larger model\n",
        "\n",
        "We keep the evaluation realistic using subject-independent splits (GroupKFold by subject),\n",
        "so the reported accuracy is not inflated by user leakage.\n"
      ],
      "metadata": {
        "id": "I8DngYwI23cG"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# =========================\n",
        "# 0) Install + Imports\n",
        "# =========================\n",
        "!pip -q install tensorflow pandas numpy scikit-learn\n",
        "\n",
        "import os, glob\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import tensorflow as tf\n",
        "\n",
        "from google.colab import drive\n",
        "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
        "\n",
        "tf.random.set_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "# =========================\n",
        "# 1) Mount Drive + Load Data\n",
        "# =========================\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "DATA_DIR = os.environ.get(\"WISDM_DATA_DIR\", os.path.join(os.getcwd(), \"data\", \"WISDM-51\"))"   # <-- your folder\n",
        "print(\"Files in folder:\", len(glob.glob(os.path.join(DATA_DIR, \"*.csv\"))))\n",
        "print(\"Sample:\", glob.glob(os.path.join(DATA_DIR, \"*.csv\"))[:5])\n",
        "\n",
        "accel_files = sorted(glob.glob(os.path.join(DATA_DIR, \"*accel_phone*.csv\")))\n",
        "print(\"Accel files:\", len(accel_files))\n",
        "print(\"Example accel files:\", accel_files[:3])\n",
        "\n",
        "def read_accel_file(path):\n",
        "    df = pd.read_csv(path)\n",
        "    df = df.rename(columns={\n",
        "        \"Subject-id\": \"subject\",\n",
        "        \"Activity Label\": \"activity\",\n",
        "        \"Timestamp\": \"timestamp\",\n",
        "        \"X-accel\": \"ax\",\n",
        "        \"Y-accel\": \"ay\",\n",
        "        \"Z-accel\": \"az\",\n",
        "    })\n",
        "    df = df[[\"subject\",\"activity\",\"timestamp\",\"ax\",\"ay\",\"az\"]].copy()\n",
        "    df[\"subject\"] = df[\"subject\"].astype(int)\n",
        "    df[\"activity\"] = df[\"activity\"].astype(str)\n",
        "    df[\"timestamp\"] = df[\"timestamp\"].astype(np.int64)\n",
        "    return df\n",
        "\n",
        "accel_df = pd.concat([read_accel_file(f) for f in accel_files], ignore_index=True)\n",
        "print(\"accel_df:\", accel_df.shape)\n",
        "print(accel_df.head())\n",
        "\n",
        "# =========================\n",
        "# 2) Low-cost / Low-power config\n",
        "# =========================\n",
        "WINDOW_SIZE = 64      # ~3.2s @ 20Hz\n",
        "STRIDE = 64           # no overlap -> fewer windows -> cheaper compute\n",
        "PURITY = 0.8          # keep mostly single-activity windows\n",
        "EPOCHS = 10\n",
        "BATCH_SIZE = 128\n",
        "\n",
        "print(f\"Config: window={WINDOW_SIZE}, stride={STRIDE}, purity={PURITY}, epochs={EPOCHS}\")\n",
        "\n",
        "# =========================\n",
        "# 3) Subject-independent split (realistic)\n",
        "# =========================\n",
        "subjects = np.sort(accel_df[\"subject\"].unique())\n",
        "np.random.shuffle(subjects)\n",
        "\n",
        "split = int(0.8 * len(subjects))\n",
        "train_subjects = subjects[:split]\n",
        "test_subjects  = subjects[split:]\n",
        "\n",
        "print(\"Train subjects:\", len(train_subjects), \"Test subjects:\", len(test_subjects))\n",
        "\n",
        "# =========================\n",
        "# 4) Windowing (creates training samples)\n",
        "# =========================\n",
        "def make_windows(df_s, window_size=64, stride=64, purity=0.8):\n",
        "    df_s = df_s.sort_values(\"timestamp\").reset_index(drop=True)\n",
        "    X_list, y_list = [], []\n",
        "    n = len(df_s)\n",
        "\n",
        "    for start in range(0, n - window_size + 1, stride):\n",
        "        w = df_s.iloc[start:start+window_size]\n",
        "        labels = w[\"activity\"].values\n",
        "\n",
        "        vals, counts = np.unique(labels, return_counts=True)\n",
        "        maj = vals[np.argmax(counts)]\n",
        "        maj_ratio = counts.max() / window_size\n",
        "        if maj_ratio < purity:\n",
        "            continue\n",
        "\n",
        "        arr = w[[\"ax\",\"ay\",\"az\"]].to_numpy(dtype=np.float32)\n",
        "        X_list.append(arr)\n",
        "        y_list.append(maj)\n",
        "\n",
        "    if len(X_list) == 0:\n",
        "        return None, None\n",
        "    return np.stack(X_list), np.array(y_list)\n",
        "\n",
        "def window_all_subjects(df, subjects, window_size=64, stride=64, purity=0.8):\n",
        "    X_all, y_all = [], []\n",
        "    for s in subjects:\n",
        "        df_s = df[df[\"subject\"]==s]\n",
        "        X_s, y_s = make_windows(df_s, window_size, stride, purity)\n",
        "        if X_s is None:\n",
        "            continue\n",
        "        X_all.append(X_s)\n",
        "        y_all.append(y_s)\n",
        "\n",
        "    X = np.concatenate(X_all, axis=0)\n",
        "    y = np.concatenate(y_all, axis=0)\n",
        "    return X, y\n",
        "\n",
        "X_train, y_train = window_all_subjects(accel_df, train_subjects, WINDOW_SIZE, STRIDE, PURITY)\n",
        "X_test,  y_test  = window_all_subjects(accel_df, test_subjects,  WINDOW_SIZE, STRIDE, PURITY)\n",
        "\n",
        "print(\"Train windows:\", X_train.shape, \"Test windows:\", X_test.shape)\n",
        "print(\"Example train label counts:\", pd.Series(y_train).value_counts().head())\n",
        "\n",
        "# =========================\n",
        "# 5) Label encoding (train-only)\n",
        "# =========================\n",
        "classes = np.unique(y_train)\n",
        "cls2id = {c:i for i,c in enumerate(classes)}\n",
        "id2cls = {i:c for c,i in cls2id.items()}\n",
        "\n",
        "y_train_id = np.array([cls2id[v] for v in y_train], dtype=np.int32)\n",
        "y_test_id  = np.array([cls2id[v] for v in y_test], dtype=np.int32)  # assumes test labels exist in train set\n",
        "\n",
        "print(\"Num classes:\", len(classes), \"Classes:\", classes)\n",
        "\n",
        "# =========================\n",
        "# 6) Standardize (using training stats)\n",
        "# =========================\n",
        "mean = X_train.mean(axis=(0,1), keepdims=True)\n",
        "std  = X_train.std(axis=(0,1), keepdims=True) + 1e-8\n",
        "\n",
        "X_train_n = (X_train - mean) / std\n",
        "X_test_n  = (X_test  - mean) / std\n",
        "\n",
        "# =========================\n",
        "# 7) Build and Train a Small CNN (runs training)\n",
        "# =========================\n",
        "def build_tiny_cnn_low_cost(input_shape, num_classes):\n",
        "    inputs = tf.keras.Input(shape=input_shape)\n",
        "\n",
        "    x = tf.keras.layers.Conv1D(8, 7, padding=\"same\", activation=\"relu\")(inputs)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(16, 5, padding=\"same\", activation=\"relu\")(x)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(32, 3, padding=\"same\", activation=\"relu\")(x)\n",
        "\n",
        "    x = tf.keras.layers.GlobalAveragePooling1D()(x)\n",
        "    x = tf.keras.layers.Dropout(0.2)(x)\n",
        "\n",
        "    outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)\n",
        "\n",
        "    model = tf.keras.Model(inputs, outputs)\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n",
        "\n",
        "model = build_tiny_cnn_low_cost((WINDOW_SIZE, 3), len(classes))\n",
        "model.summary()\n",
        "print(\"Total params:\", model.count_params())\n",
        "\n",
        "callbacks = [\n",
        "    tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=3, restore_best_weights=True)\n",
        "]\n",
        "\n",
        "history = model.fit(\n",
        "    X_train_n, y_train_id,\n",
        "    validation_split=0.15,\n",
        "    epochs=EPOCHS,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    callbacks=callbacks,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# =========================\n",
        "# 8) Evaluate (runs prediction + metrics)\n",
        "# =========================\n",
        "probs = model.predict(X_test_n, verbose=0)\n",
        "pred_id = np.argmax(probs, axis=1)\n",
        "y_pred = np.array([id2cls[i] for i in pred_id])\n",
        "\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "f1m = f1_score(y_test, y_pred, average=\"macro\")\n",
        "\n",
        "print(\"\\n===== Test Results (Subject-independent split) =====\")\n",
        "print(\"Accuracy:\", acc)\n",
        "print(\"Macro-F1 :\", f1m)\n",
        "print(\"\\nClassification report:\\n\", classification_report(y_test, y_pred))\n"
      ],
      "metadata": {
