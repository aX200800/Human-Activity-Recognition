    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# ✅ EVALUATION PLOTS FOR MVP MODEL (Confidence + Calibration + More)\n",
        "# ============================================================\n",
        "# Requirements: model, X_test_n, y_test, id2cls, classes\n",
        "# This will:\n",
        "# 1) Run predictions on the test set\n",
        "# 2) Compute confidence, correctness, per-class metrics\n",
        "# 3) Plot multiple evaluation graphs\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.metrics import confusion_matrix, f1_score, precision_recall_fscore_support\n",
        "from sklearn.calibration import calibration_curve\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 1: Run model predictions on test set\n",
        "# ------------------------------------------------------------\n",
        "probs = model.predict(X_test_n, verbose=0)                 # shape: (N, num_classes)\n",
        "pred_id = np.argmax(probs, axis=1)                         # predicted class index\n",
        "conf = np.max(probs, axis=1)                               # confidence of prediction\n",
        "top2_id = np.argsort(probs, axis=1)[:, -2:]                # top-2 classes\n",
        "\n",
        "# true labels: activity codes (e.g., \"A\",\"B\"...)\n",
        "# convert true label codes to ids using cls2id (build it if not available)\n",
        "cls2id = {c:i for i,c in enumerate(classes)}\n",
        "y_true_id = np.array([cls2id[v] for v in y_test], dtype=int)\n",
        "\n",
        "# decode predicted ids -> codes\n",
        "y_pred = np.array([id2cls[i] for i in pred_id])\n",
        "\n",
        "correct = (pred_id == y_true_id)\n",
        "\n",
        "print(\"Test windows:\", len(y_test))\n",
        "print(\"Accuracy:\", correct.mean())\n",
        "print(\"Macro-F1:\", f1_score(y_test, y_pred, average=\"macro\"))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 2: Plot 1 - Confidence histogram (overall)\n",
        "# ------------------------------------------------------------\n",
        "plt.figure(figsize=(6,4))\n",
        "plt.hist(conf, bins=30)\n",
        "plt.title(\"Confidence Distribution (All Test Predictions)\")\n",
        "plt.xlabel(\"Predicted confidence (max softmax probability)\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 3: Plot 2 - Confidence histogram (Correct vs Wrong)\n",
        "# ------------------------------------------------------------\n",
        "plt.figure(figsize=(6,4))\n",
        "plt.hist(conf[correct], bins=30, alpha=0.7, label=\"Correct\")\n",
        "plt.hist(conf[~correct], bins=30, alpha=0.7, label=\"Wrong\")\n",
        "plt.title(\"Confidence Distribution: Correct vs Wrong\")\n",
        "plt.xlabel(\"Predicted confidence\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 4: Plot 3 - Accuracy vs confidence bins (Calibration-style)\n",
        "# ------------------------------------------------------------\n",
        "# We bin confidence values and compute accuracy inside each bin.\n",
        "bins = np.linspace(0, 1, 11)  # 10 bins\n",
        "bin_ids = np.digitize(conf, bins) - 1\n",
        "\n",
        "bin_acc = []\n",
        "bin_conf = []\n",
        "bin_counts = []\n",
        "\n",
        "for b in range(len(bins)-1):\n",
        "    mask = (bin_ids == b)\n",
        "    if mask.sum() == 0:\n",
        "        continue\n",
        "    bin_counts.append(mask.sum())\n",
        "    bin_acc.append(correct[mask].mean())\n",
        "    bin_conf.append(conf[mask].mean())\n",
        "\n",
        "plt.figure(figsize=(6,4))\n",
        "plt.plot(bin_conf, bin_acc, marker=\"o\")\n",
        "plt.plot([0,1], [0,1], linestyle=\"--\")   # perfect calibration line\n",
        "plt.title(\"Accuracy vs Confidence Bins (Calibration-style)\")\n",
        "plt.xlabel(\"Mean confidence in bin\")\n",
        "plt.ylabel(\"Accuracy in bin\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 5: Plot 4 - Reliability diagram (Expected Calibration Curve)\n",
        "# ------------------------------------------------------------\n",
        "# For multiclass, a common approximation is to use max-prob confidence vs correctness.\n",
        "frac_pos, mean_pred = calibration_curve(correct.astype(int), conf, n_bins=10, strategy=\"uniform\")\n",
        "\n",
        "plt.figure(figsize=(6,4))\n",
        "plt.plot(mean_pred, frac_pos, marker=\"o\", label=\"Model\")\n",
        "plt.plot([0,1], [0,1], linestyle=\"--\", label=\"Perfectly calibrated\")\n",
        "plt.title(\"Reliability Diagram (Expected Calibration Curve)\")\n",
        "plt.xlabel(\"Mean predicted confidence\")\n",
        "plt.ylabel(\"Fraction correct\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 6: Plot 5 - Confusion Matrix (Normalized)\n",
        "# ------------------------------------------------------------\n",
        "labels = np.array(sorted(np.unique(y_test)))  # ensure consistent label order\n",
        "cm = confusion_matrix(y_test, y_pred, labels=labels)\n",
        "\n",
        "# normalize by row (true class)\n",
        "cm_norm = cm / (cm.sum(axis=1, keepdims=True) + 1e-9)\n",
        "\n",
        "plt.figure(figsize=(7,6))\n",
        "plt.imshow(cm_norm)\n",
        "plt.title(\"Normalized Confusion Matrix (rows sum to 1)\")\n",
        "plt.xticks(range(len(labels)), labels, rotation=90)\n",
        "plt.yticks(range(len(labels)), labels)\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"True\")\n",
        "plt.colorbar()\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 7: Plot 6 - Per-class F1 bar chart\n",
        "# ------------------------------------------------------------\n",
        "prec, rec, f1s, sup = precision_recall_fscore_support(y_test, y_pred, labels=labels, zero_division=0)\n",
        "\n",
        "plt.figure(figsize=(7,4))\n",
        "plt.bar(labels, f1s)\n",
        "plt.title(\"Per-class F1 Score\")\n",
        "plt.xlabel(\"Class\")\n",
        "plt.ylabel(\"F1\")\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 8: Metric - Top-2 Accuracy\n",
        "# ------------------------------------------------------------\n",
        "top2_correct = np.array([y_true_id[i] in top2_id[i] for i in range(len(y_true_id))])\n",
        "print(\"Top-1 Accuracy:\", correct.mean())\n",
        "print(\"Top-2 Accuracy:\", top2_correct.mean())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# STEP 9: \"Confidence Interval\" plot (Binomial 95% CI per confidence bin)\n",
        "# ------------------------------------------------------------\n",
        "# Interpretation: For each confidence bin, we plot accuracy with a 95% binomial CI.\n",
        "# This shows uncertainty when a bin has few samples.\n",
        "\n",
        "def wilson_ci(k, n, z=1.96):\n",
        "    # Wilson score interval for a proportion\n",
        "    if n == 0:\n",
        "        return (np.nan, np.nan)\n",
        "    p = k / n\n",
        "    denom = 1 + z*z/n\n",
        "    center = (p + z*z/(2*n)) / denom\n",
        "    margin = (z * np.sqrt((p*(1-p)/n) + (z*z/(4*n*n)))) / denom\n",
        "    return center - margin, center + margin\n",
        "\n",
        "bin_centers = []\n",
        "bin_acc2 = []\n",
        "bin_low = []\n",
        "bin_high = []\n",
        "bin_n = []\n",
        "\n",
        "for b in range(len(bins)-1):\n",
        "    mask = (bin_ids == b)\n",
        "    n = mask.sum()\n",
        "    if n == 0:\n",
        "        continue\n",
        "    k = correct[mask].sum()\n",
        "    acc_b = k / n\n",
        "    lo, hi = wilson_ci(k, n)\n",
        "\n",
        "    center_conf = (bins[b] + bins[b+1]) / 2\n",
        "    bin_centers.append(center_conf)\n",
        "    bin_acc2.append(acc_b)\n",
        "    bin_low.append(lo)\n",
        "    bin_high.append(hi)\n",
        "    bin_n.append(n)\n",
        "\n",
        "plt.figure(figsize=(6,4))\n",
        "plt.plot(bin_centers, bin_acc2, marker=\"o\", label=\"Accuracy per bin\")\n",
        "plt.fill_between(bin_centers, bin_low, bin_high, alpha=0.2, label=\"95% CI (Wilson)\")\n",
        "plt.title(\"Accuracy with 95% Confidence Intervals vs Confidence Bins\")\n",
        "plt.xlabel(\"Confidence bin center\")\n",
        "plt.ylabel(\"Accuracy\")\n",
        "plt.ylim(0,1)\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "# Optional: show bin counts (helps explain wide intervals)\n",
        "plt.figure(figsize=(6,3))\n",
        "plt.bar([str((bins[i], bins[i+1])) for i in range(len(bins)-1)], [ (bin_ids==i).sum() for i in range(len(bins)-1) ])\n",
        "plt.title(\"Number of Samples per Confidence Bin\")\n",
        "plt.xlabel(\"Confidence bin\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.xticks(rotation=60)\n",
        "plt.show()\n"
      ],
