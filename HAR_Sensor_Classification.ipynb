      "source": [
        "EDA (counts, sampling, quick signal plots)"
      ],
      "metadata": {
        "id": "w4iCv75Qmqv3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Add human-readable activity name\n",
        "full_df[\"activity_name\"] = full_df[\"activity\"].map(ACTIVITY_MAP).fillna(full_df[\"activity\"])\n",
        "\n",
        "print(\"Subjects:\", full_df[\"subject\"].nunique())\n",
        "print(\"Activities:\", full_df[\"activity_name\"].nunique())\n",
        "print(full_df[\"activity_name\"].value_counts().head(10))\n",
        "\n",
        "# --- Activity distribution ---\n",
        "plt.figure()\n",
        "full_df[\"activity_name\"].value_counts().plot(kind=\"bar\")\n",
        "plt.title(\"Samples per Activity\")\n",
        "plt.ylabel(\"Rows\")\n",
        "plt.xticks(rotation=60)\n",
        "plt.show()\n",
        "\n",
        "# --- Subject distribution ---\n",
        "plt.figure()\n",
        "full_df[\"subject\"].value_counts().plot(kind=\"bar\")\n",
        "plt.title(\"Samples per Subject\")\n",
        "plt.ylabel(\"Rows\")\n",
        "plt.show()\n",
        "\n",
        "# --- Sampling interval check (one subject/activity) ---\n",
        "example = full_df[(full_df[\"subject\"]==full_df[\"subject\"].iloc[0])].copy()\n",
        "example = example.sort_values(\"timestamp\")\n",
        "dt = example[\"timestamp\"].diff().dropna()\n",
        "\n",
        "plt.figure()\n",
        "plt.hist(dt, bins=50)\n",
        "plt.title(\"Timestamp Δ distribution (example subject)\")\n",
        "plt.xlabel(\"Δ timestamp (ns)\")\n",
        "plt.ylabel(\"count\")\n",
        "plt.show()\n",
        "\n",
        "# --- Signal magnitude plots (pick a subject and 2 activities) ---\n",
        "def plot_activity_segment(df, subject, activity_code, n=400):\n",
        "    seg = df[(df[\"subject\"]==subject) & (df[\"activity\"]==activity_code)].sort_values(\"timestamp\").head(n).copy()\n",
        "    acc_mag = np.sqrt(seg[\"ax\"]**2 + seg[\"ay\"]**2 + seg[\"az\"]**2)\n",
        "\n",
        "    plt.figure()\n",
        "    plt.plot(acc_mag.values)\n",
        "    plt.title(f\"Acc magnitude: subject {subject}, activity {ACTIVITY_MAP.get(activity_code, activity_code)}\")\n",
        "    plt.xlabel(\"sample\")\n",
        "    plt.ylabel(\"|acc|\")\n",
        "    plt.show()\n",
        "\n",
        "    if seg[[\"gx\",\"gy\",\"gz\"]].notna().all(axis=1).any():\n",
        "        seg2 = seg.dropna(subset=[\"gx\",\"gy\",\"gz\"])\n",
        "        gyro_mag = np.sqrt(seg2[\"gx\"]**2 + seg2[\"gy\"]**2 + seg2[\"gz\"]**2)\n",
        "        plt.figure()\n",
        "        plt.plot(gyro_mag.values)\n",
        "        plt.title(f\"Gyro magnitude: subject {subject}, activity {ACTIVITY_MAP.get(activity_code, activity_code)}\")\n",
        "        plt.xlabel(\"sample\")\n",
        "        plt.ylabel(\"|gyro|\")\n",
        "        plt.show()\n",
        "\n",
        "subj0 = full_df[\"subject\"].iloc[0]\n",
        "plot_activity_segment(full_df, subj0, \"A\")  # Walking\n",
        "plot_activity_segment(full_df, subj0, \"D\")  # Sitting\n"
      ],
