      "source": [
        "# ====== Colab Setup ======\n",
        "!pip -q install pandas numpy matplotlib scikit-learn\n",
        "\n",
        "import os, glob, re\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.model_selection import GroupKFold\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import accuracy_score, f1_score, classification_report, confusion_matrix\n"
      ],
      "metadata": {
        "id": "m5J5oRmzlO-G"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ✅ CHANGE THIS to your folder containing the 51 csv files\n",
        "DATA_DIR = os.environ.get(\"WISDM_DATA_DIR\", os.path.join(os.getcwd(), \"data\", \"WISDM-51\"))"\n",
        "\n",
        "print(\"Files in folder:\", len(glob.glob(os.path.join(DATA_DIR, \"*.csv\"))))\n",
        "print(\"Sample:\", glob.glob(os.path.join(DATA_DIR, \"*.csv\"))[:5])\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "q7D1Yx0MlQXX",
        "outputId": "78e16f22-9fbc-458b-cbbd-4efff6db50e7"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Files in folder: 51\n",
            "Sample: ['/content/drive/MyDrive/HAR_WISDM/WISDM-51/data_1642_accel_phone.csv', '/content/drive/MyDrive/HAR_WISDM/WISDM-51/data_1632_accel_phone.csv', '/content/drive/MyDrive/HAR_WISDM/WISDM-51/data_1646_accel_phone.csv', '/content/drive/MyDrive/HAR_WISDM/WISDM-51/data_1649_accel_phone.csv', '/content/drive/MyDrive/HAR_WISDM/WISDM-51/data_1641_accel_phone.csv']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ====== Activity label mapping (common WISDM codes) ======\n",
        "ACTIVITY_MAP = {\n",
        "    \"A\": \"Walking\",\n",
        "    \"B\": \"Jogging\",\n",
        "    \"C\": \"Stairs\",\n",
        "    \"D\": \"Sitting\",\n",
        "    \"E\": \"Standing\",\n",
        "    \"F\": \"Typing\",\n",
        "    \"G\": \"Brushing Teeth\",\n",
        "    \"H\": \"Eating Soup\",\n",
        "    \"I\": \"Eating Chips\",\n",
        "    \"J\": \"Eating Pasta\",\n",
        "    \"K\": \"Drinking (Cup)\",\n",
        "    \"L\": \"Eating Sandwich\",\n",
        "    \"M\": \"Kicking (Soccer Ball)\",\n",
        "    \"O\": \"Playing Catch (Tennis Ball)\",\n",
        "    \"P\": \"Dribbling (Basketball)\",\n",
        "    \"Q\": \"Writing\",\n",
        "    \"R\": \"Clapping\",\n",
        "    \"S\": \"Folding Clothes\",\n",
        "}\n",
        "\n",
        "def read_sensor_file(path, sensor_type):\n",
        "    \"\"\"\n",
        "    sensor_type: 'accel' or 'gyro'\n",
        "    Returns standardized columns:\n",
        "    subject, activity, timestamp, ax, ay, az  OR  gx, gy, gz\n",
        "    \"\"\"\n",
        "    df = pd.read_csv(path)\n",
        "\n",
        "    # Standardize column names (based on your sample)\n",
        "    df = df.rename(columns={\n",
        "        \"Subject-id\": \"subject\",\n",
        "        \"Activity Label\": \"activity\",\n",
        "        \"Timestamp\": \"timestamp\",\n",
        "    })\n",
        "\n",
        "    # Detect axis columns\n",
        "    cols = df.columns.str.lower()\n",
        "\n",
        "    if sensor_type == \"accel\":\n",
        "        # e.g. X-accel, Y-accel, Z-accel\n",
        "        xcol = [c for c in df.columns if \"x\" in c.lower() and \"accel\" in c.lower()][0]\n",
        "        ycol = [c for c in df.columns if \"y\" in c.lower() and \"accel\" in c.lower()][0]\n",
        "        zcol = [c for c in df.columns if \"z\" in c.lower() and \"accel\" in c.lower()][0]\n",
        "        df = df.rename(columns={xcol:\"ax\", ycol:\"ay\", zcol:\"az\"})\n",
        "        keep = [\"subject\",\"activity\",\"timestamp\",\"ax\",\"ay\",\"az\"]\n",
        "    else:\n",
        "        # e.g. X-gyro, Y-gyro, Z-gyro (may vary slightly)\n",
        "        xcol = [c for c in df.columns if \"x\" in c.lower() and \"gyro\" in c.lower()][0]\n",
        "        ycol = [c for c in df.columns if \"y\" in c.lower() and \"gyro\" in c.lower()][0]\n",
        "        zcol = [c for c in df.columns if \"z\" in c.lower() and \"gyro\" in c.lower()][0]\n",
        "        df = df.rename(columns={xcol:\"gx\", ycol:\"gy\", zcol:\"gz\"})\n",
        "        keep = [\"subject\",\"activity\",\"timestamp\",\"gx\",\"gy\",\"gz\"]\n",
        "\n",
        "    df = df[keep].copy()\n",
        "    df[\"subject\"] = df[\"subject\"].astype(int)\n",
        "    df[\"activity\"] = df[\"activity\"].astype(str)\n",
        "    df[\"timestamp\"] = df[\"timestamp\"].astype(np.int64)\n",
        "\n",
        "    return df\n",
        "\n",
        "def load_all_phone_data(data_dir):\n",
        "    accel_files = sorted(glob.glob(os.path.join(data_dir, \"*accel_phone*.csv\")))\n",
        "    gyro_files  = sorted(glob.glob(os.path.join(data_dir, \"*gyro_phone*.csv\")))\n",
        "\n",
        "    print(\"Accel files:\", len(accel_files))\n",
        "    print(\"Gyro files :\", len(gyro_files))\n",
        "\n",
        "    accel_list = [read_sensor_file(f, \"accel\") for f in accel_files]\n",
        "    accel = pd.concat(accel_list, ignore_index=True)\n",
        "\n",
        "    gyro = None\n",
        "    if len(gyro_files) > 0:\n",
        "        gyro_list = [read_sensor_file(f, \"gyro\") for f in gyro_files]\n",
        "        gyro = pd.concat(gyro_list, ignore_index=True)\n",
        "\n",
        "    return accel, gyro\n",
        "\n",
        "accel_df, gyro_df = load_all_phone_data(DATA_DIR)\n",
        "accel_df.head()\n"
      ],
