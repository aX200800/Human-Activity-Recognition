      "cell_type": "code",
      "source": [
        "def make_windows(df_s, window_size=128, stride=64, purity=0.8):\n",
        "    \"\"\"\n",
        "    df_s: dataframe for one subject (mixed activities)\n",
        "    Returns:\n",
        "      X: (N, T, 3), y: (N,)\n",
        "    \"\"\"\n",
        "    df_s = df_s.sort_values(\"timestamp\").reset_index(drop=True)\n",
        "\n",
        "    X_list, y_list = [], []\n",
        "    n = len(df_s)\n",
        "\n",
        "    for start in range(0, n - window_size + 1, stride):\n",
        "        w = df_s.iloc[start:start+window_size]\n",
        "        labels = w[\"activity\"].values\n",
        "\n",
        "        vals, counts = np.unique(labels, return_counts=True)\n",
        "        maj = vals[np.argmax(counts)]\n",
        "        maj_ratio = counts.max() / window_size\n",
        "        if maj_ratio < purity:\n",
        "            continue\n",
        "\n",
        "        arr = w[[\"ax\",\"ay\",\"az\"]].to_numpy(dtype=np.float32)\n",
        "        X_list.append(arr)\n",
        "        y_list.append(maj)\n",
        "\n",
        "    if len(X_list) == 0:\n",
        "        return None, None\n",
        "    return np.stack(X_list), np.array(y_list)\n",
        "\n",
        "def window_all_subjects(df, subjects, window_size=128, stride=64, purity=0.8):\n",
        "    X_all, y_all, g_all = [], [], []\n",
        "    for s in subjects:\n",
        "        df_s = df[df[\"subject\"]==s]\n",
        "        X_s, y_s = make_windows(df_s, window_size, stride, purity)\n",
        "        if X_s is None:\n",
        "            continue\n",
        "        X_all.append(X_s)\n",
        "        y_all.append(y_s)\n",
        "        g_all.append(np.full(len(y_s), s))\n",
        "    X = np.concatenate(X_all, axis=0)\n",
        "    y = np.concatenate(y_all, axis=0)\n",
        "    groups = np.concatenate(g_all, axis=0)\n",
        "    return X, y, groups\n",
        "\n",
        "# Label encoding helpers\n",
        "def fit_label_encoder(y):\n",
        "    classes = np.unique(y)\n",
        "    cls2id = {c:i for i,c in enumerate(classes)}\n",
        "    id2cls = {i:c for c,i in cls2id.items()}\n",
        "    return classes, cls2id, id2cls\n",
        "\n",
        "def encode_labels(y, cls2id):\n",
        "    return np.array([cls2id[v] for v in y], dtype=np.int32)\n"
      ],
