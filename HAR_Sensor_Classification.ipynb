    {
      "cell_type": "markdown",
      "source": [
        "Merge accel + gyro (safe merge)\n",
        "\n",
        "Gyro timestamps might not match exactly, so we use a nearest timestamp merge within a tolerance"
      ],
      "metadata": {
        "id": "I_n2yt8Zmhyr"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def merge_accel_gyro(accel, gyro, tolerance_ns=60_000_000):\n",
        "    \"\"\"\n",
        "    Merge using merge_asof (nearest timestamp) within each subject+activity.\n",
        "    tolerance_ns ~ 60ms by default (20Hz is 50ms).\n",
        "    \"\"\"\n",
        "    if gyro is None:\n",
        "        out = accel.copy()\n",
        "        out[\"gx\"] = np.nan\n",
        "        out[\"gy\"] = np.nan\n",
        "        out[\"gz\"] = np.nan\n",
        "        return out\n",
        "\n",
        "    accel = accel.sort_values([\"subject\",\"activity\",\"timestamp\"]).reset_index(drop=True)\n",
        "    gyro  = gyro.sort_values([\"subject\",\"activity\",\"timestamp\"]).reset_index(drop=True)\n",
        "\n",
        "    merged = pd.merge_asof(\n",
        "        accel,\n",
        "        gyro,\n",
        "        by=[\"subject\",\"activity\"],\n",
        "        on=\"timestamp\",\n",
        "        direction=\"nearest\",\n",
        "        tolerance=tolerance_ns\n",
        "    )\n",
        "\n",
        "    # Some rows may not find a match => gx/gy/gz become NaN.\n",
        "    return merged\n",
        "\n",
        "full_df = merge_accel_gyro(accel_df, gyro_df)\n",
        "print(\"Merged shape:\", full_df.shape)\n",
        "print(\"Missing gyro rows:\", full_df[[\"gx\",\"gy\",\"gz\"]].isna().any(axis=1).mean())\n",
        "full_df.head()\n"
      ],
