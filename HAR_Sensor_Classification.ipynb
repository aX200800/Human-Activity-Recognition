      "cell_type": "markdown",
      "source": [
        "Subject-based split first (to avoid unrealistic accuracy)\n",
        "\n",
        "We will build windows inside each fold’s train/test subjects."
      ],
      "metadata": {
        "id": "ZHuCZTbrmupg"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "Windowing + feature extraction for Random Forest"
      ],
      "metadata": {
        "id": "C-Zrmb3NmwQE"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def make_windows_for_subject_activity(df_sa, window_size=128, stride=64, purity=0.8):\n",
        "    \"\"\"\n",
        "    df_sa: data for ONE subject and ONE activity (or could contain mixed activity if you pass bigger df)\n",
        "    We will create windows sequentially, and label by majority activity in the window.\n",
        "    purity: keep window only if majority label proportion >= purity (avoids transitions)\n",
        "    \"\"\"\n",
        "    df_sa = df_sa.sort_values(\"timestamp\").reset_index(drop=True)\n",
        "\n",
        "    X_list, y_list = [], []\n",
        "    n = len(df_sa)\n",
        "    for start in range(0, n - window_size + 1, stride):\n",
        "        w = df_sa.iloc[start:start+window_size]\n",
        "        labels = w[\"activity\"].values\n",
        "        # majority label\n",
        "        vals, counts = np.unique(labels, return_counts=True)\n",
        "        maj = vals[np.argmax(counts)]\n",
        "        maj_ratio = counts.max() / window_size\n",
        "        if maj_ratio < purity:\n",
        "            continue\n",
        "\n",
        "        # channels (use accel + gyro if present)\n",
        "        channels = [\"ax\",\"ay\",\"az\",\"gx\",\"gy\",\"gz\"]\n",
        "        arr = w[channels].to_numpy(dtype=np.float32)\n",
        "\n",
        "        # If gyro missing for some rows, fill with 0 (or you can drop those windows)\n",
        "        arr = np.nan_to_num(arr, nan=0.0)\n",
        "\n",
        "        X_list.append(arr)\n",
        "        y_list.append(maj)\n",
        "\n",
        "    if len(X_list) == 0:\n",
        "        return None, None\n",
        "    return np.stack(X_list), np.array(y_list)\n",
        "\n",
        "def window_all(df, subjects, window_size=128, stride=64, purity=0.8):\n",
        "    X_all, y_all, g_all = [], [], []\n",
        "\n",
        "    sub_df = df[df[\"subject\"].isin(subjects)].copy()\n",
        "\n",
        "    for s in subjects:\n",
        "        df_s = sub_df[sub_df[\"subject\"]==s]\n",
        "        # build windows across all rows (mixed activities possible)\n",
        "        X_s, y_s = make_windows_for_subject_activity(df_s, window_size, stride, purity)\n",
        "        if X_s is None:\n",
        "            continue\n",
        "        X_all.append(X_s)\n",
        "        y_all.append(y_s)\n",
        "        g_all.append(np.full(len(y_s), s))\n",
        "\n",
        "    X = np.concatenate(X_all, axis=0)\n",
        "    y = np.concatenate(y_all, axis=0)\n",
        "    groups = np.concatenate(g_all, axis=0)\n",
        "    return X, y, groups\n",
        "\n",
        "def extract_features(X):\n",
        "    \"\"\"\n",
        "    X: (N, T, C) -> features (N, F)\n",
        "    Simple stats per channel + magnitude stats.\n",
        "    \"\"\"\n",
        "    N, T, C = X.shape\n",
        "    feats = []\n",
        "\n",
        "    # per-channel stats\n",
        "    mean = X.mean(axis=1)\n",
        "    std  = X.std(axis=1)\n",
        "    mn   = X.min(axis=1)\n",
        "    mx   = X.max(axis=1)\n",
        "    med  = np.median(X, axis=1)\n",
        "    energy = (X**2).mean(axis=1)\n",
        "\n",
        "    feats.extend([mean, std, mn, mx, med, energy])\n",
        "\n",
        "    # magnitude stats for accel and gyro\n",
        "    ax, ay, az = X[:,:,0], X[:,:,1], X[:,:,2]\n",
        "    acc_mag = np.sqrt(ax**2 + ay**2 + az**2)\n",
        "    acc_mean = acc_mag.mean(axis=1, keepdims=True)\n",
        "    acc_std  = acc_mag.std(axis=1, keepdims=True)\n",
        "    feats.extend([acc_mean, acc_std])\n",
        "\n",
        "    # gyro may be filled with 0 if missing\n",
        "    gx, gy, gz = X[:,:,3], X[:,:,4], X[:,:,5]\n",
        "    gyro_mag = np.sqrt(gx**2 + gy**2 + gz**2)\n",
        "    gyro_mean = gyro_mag.mean(axis=1, keepdims=True)\n",
        "    gyro_std  = gyro_mag.std(axis=1, keepdims=True)\n",
        "    feats.extend([gyro_mean, gyro_std])\n",
        "\n",
        "    return np.concatenate(feats, axis=1)\n"
      ],
      "metadata": {
        "id": "W7pOw1mjmsZZ"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Random Forest baseline with GroupKFold (subject-independent)"
      ],
      "metadata": {
        "id": "TuUXOMv2mzzX"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Define subjects and folds\n",
        "subjects = np.sort(full_df[\"subject\"].unique())\n",
        "print(\"Total subjects:\", len(subjects))\n",
        "\n",
        "gkf = GroupKFold(n_splits=5)\n",
        "\n",
        "# We will window inside each fold to prevent leakage\n",
        "all_fold_metrics = []\n",
        "all_y_true = []\n",
        "all_y_pred = []\n",
        "\n",
        "for fold, (train_idx, test_idx) in enumerate(gkf.split(subjects, groups=subjects), start=1):\n",
        "    train_subjects = subjects[train_idx]\n",
        "    test_subjects  = subjects[test_idx]\n",
        "\n",
        "    X_train_seq, y_train, g_train = window_all(full_df, train_subjects, window_size=128, stride=64, purity=0.8)\n",
        "    X_test_seq,  y_test,  g_test  = window_all(full_df, test_subjects,  window_size=128, stride=64, purity=0.8)\n",
        "\n",
        "    X_train = extract_features(X_train_seq)\n",
        "    X_test  = extract_features(X_test_seq)\n",
        "\n",
        "    clf = RandomForestClassifier(\n",
        "        n_estimators=250,\n",
        "        random_state=42,\n",
        "        n_jobs=-1,\n",
        "        class_weight=\"balanced_subsample\"\n",
        "    )\n",
        "    clf.fit(X_train, y_train)\n",
        "    pred = clf.predict(X_test)\n",
        "\n",
        "    acc = accuracy_score(y_test, pred)\n",
        "    f1m = f1_score(y_test, pred, average=\"macro\")\n",
        "\n",
        "    print(f\"\\nFold {fold}: windows train={len(y_train)} test={len(y_test)} | Acc={acc:.4f} Macro-F1={f1m:.4f}\")\n",
        "    all_fold_metrics.append((fold, acc, f1m))\n",
        "\n",
        "    all_y_true.append(y_test)\n",
        "    all_y_pred.append(pred)\n",
        "\n",
        "# Overall\n",
        "y_true = np.concatenate(all_y_true)\n",
        "y_pred = np.concatenate(all_y_pred)\n",
        "\n",
        "print(\"\\n===== Overall (all folds combined) =====\")\n",
        "print(\"Accuracy:\", accuracy_score(y_true, y_pred))\n",
        "print(\"Macro-F1 :\", f1_score(y_true, y_pred, average=\"macro\"))\n",
        "print(\"\\nClassification Report:\\n\", classification_report(y_true, y_pred))\n",
        "\n",
        "cm = confusion_matrix(y_true, y_pred, labels=np.unique(y_true))\n",
        "plt.figure(figsize=(8,8))\n",
        "plt.imshow(cm)\n",
        "plt.title(\"Confusion Matrix (labels are activity codes)\")\n",
        "plt.xticks(range(len(np.unique(y_true))), np.unique(y_true), rotation=90)\n",
        "plt.yticks(range(len(np.unique(y_true))), np.unique(y_true))\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"True\")\n",
        "plt.show()\n",
        "\n",
        "pd.DataFrame(all_fold_metrics, columns=[\"fold\",\"accuracy\",\"macro_f1\"])\n"
      ],
