        "# ============================================================\n",
        "# ✅ SECTION 9: EXPORT THE TRAINED CNN TO TFLite (INT8 QUANTIZED)\n",
        "# ============================================================\n",
        "# WHY ARE WE DOING THIS?\n",
        "# - Our goal is \"low power / cost-effective\" smartphone deployment.\n",
        "# - TensorFlow Lite (TFLite) is made for running models on phones.\n",
        "# - INT8 quantization converts model weights/activations from float32 -> int8\n",
        "#   which typically gives:\n",
        "#     ✅ Smaller model size\n",
        "#     ✅ Faster inference on mobile CPU\n",
        "#     ✅ Lower energy consumption\n",
        "#\n",
        "# IMPORTANT NOTE:\n",
        "# - For full INT8 quantization we must provide a \"representative dataset\"\n",
        "#   so TensorFlow can calibrate the numeric range of activations.\n",
        "\n",
        "import os\n",
        "import tensorflow as tf\n",
        "\n",
        "# -----------------------------\n",
        "# Step 1: Representative Data\n",
        "# -----------------------------\n",
        "# This generator provides sample inputs from the training data.\n",
        "# TensorFlow uses these samples to decide how to scale float values into int8.\n",
        "#\n",
        "# We only need a small subset (e.g., 200-300 windows).\n",
        "# It MUST output float32 arrays with the same shape as the model input.\n",
        "def representative_data_gen():\n",
        "    # Use a small sample of normalized training windows for calibration\n",
        "    num_samples = min(300, len(X_train_n))\n",
        "    for i in range(num_samples):\n",
        "        yield [X_train_n[i:i+1].astype(\"float32\")]\n",
        "\n",
        "# --------------------------------------------\n",
        "# Step 2: Create the TFLite Converter Object\n",
        "# --------------------------------------------\n",
        "converter = tf.lite.TFLiteConverter.from_keras_model(model)\n",
        "\n",
        "# --------------------------------------------\n",
        "# Step 3: Enable Optimization (Quantization)\n",
        "# --------------------------------------------\n",
        "# tf.lite.Optimize.DEFAULT tells TensorFlow to try to compress + optimize.\n",
        "converter.optimizations = [tf.lite.Optimize.DEFAULT]\n",
        "\n",
        "# Provide representative dataset for calibration (required for full INT8)\n",
        "converter.representative_dataset = representative_data_gen\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Step 4: Force FULL Integer Quantization (INT8 end-to-end)\n",
        "# ---------------------------------------------------------\n",
        "# This ensures:\n",
        "# - weights use int8\n",
        "# - activations use int8\n",
        "# - input/output tensors are int8\n",
        "converter.target_spec.supported_ops = [tf.lite.OpsSet.TFLITE_BUILTINS_INT8]\n",
        "converter.inference_input_type = tf.int8\n",
        "converter.inference_output_type = tf.int8\n",
        "\n",
        "# --------------------------------------------\n",
        "# Step 5: Convert the Model\n",
        "# --------------------------------------------\n",
        "tflite_int8_model = converter.convert()\n",
        "\n",
        "# --------------------------------------------\n",
        "# Step 6: Save the .tflite file to Google Drive\n",
        "# --------------------------------------------\n",
        "TFLITE_PATH = os.environ.get(\"HAR_TFLITE_PATH\", os.path.join(os.getcwd(), \"wisdm_tinycnn_int8.tflite\"))"\n",
        "os.makedirs(os.path.dirname(TFLITE_PATH), exist_ok=True)\n",
        "\n",
        "with open(TFLITE_PATH, \"wb\") as f:\n",
        "    f.write(tflite_int8_model)\n",
        "\n",
        "print(\"✅ Saved INT8 TFLite model to:\", TFLITE_PATH)\n",
        "print(\"📦 TFLite model size (KB):\", os.path.getsize(TFLITE_PATH) / 1024)\n"
      ],
