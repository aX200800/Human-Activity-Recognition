        "# ============================================================\n",
        "# ✅ MVP SETUP: 5-class realistic activity recognition\n",
        "# Classes:\n",
        "# A Walking, B Jogging, C Stairs, D Sitting, E Standing\n",
        "# ============================================================\n",
        "KEEP = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
        "accel_mvp = accel_df[accel_df[\"activity\"].isin(KEEP)].copy()\n",
        "\n",
        "print(\"Rows after filter:\", accel_mvp.shape)\n",
        "print(\"Activities:\", accel_mvp[\"activity\"].value_counts())\n",
        "print(\"Subjects:\", accel_mvp[\"subject\"].nunique())\n"
      ],
      "metadata": {
        "id": "1LFgJpoDG9Km",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "d118c5cb-664b-4ef6-8c4b-b946c8ac575b"
      },
      "execution_count": 34,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Rows after filter: (1338067, 6)\n",
            "Activities: activity\n",
            "A    279817\n",
            "E    269604\n",
            "B    268409\n",
            "D    264592\n",
            "C    255645\n",
            "Name: count, dtype: int64\n",
            "Subjects: 51\n"
