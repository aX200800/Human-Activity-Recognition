        "# ============================================================\n",
        "# ✅ SECTION 10: QUICK TEST - RUN INFERENCE USING THE INT8 MODEL\n",
        "# ============================================================\n",
        "# WHY THIS TEST?\n",
        "# - To confirm the exported .tflite model actually works.\n",
        "# - INT8 models require INT8 input.\n",
        "# - We'll:\n",
        "#     1) Load the TFLite model\n",
        "#     2) Read quantization scaling information\n",
        "#     3) Convert one float32 input window -> int8\n",
        "#     4) Run inference\n",
        "#     5) Convert output back to float (optional)\n",
        "#     6) Print predicted vs true label\n",
        "\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "\n",
        "# -----------------------------\n",
        "# Step 1: Load the TFLite model\n",
        "# -----------------------------\n",
        "interpreter = tf.lite.Interpreter(model_path=TFLITE_PATH)\n",
        "interpreter.allocate_tensors()\n",
        "\n",
        "# -----------------------------\n",
        "# Step 2: Get input/output details\n",
        "# -----------------------------\n",
        "input_details = interpreter.get_input_details()\n",
        "output_details = interpreter.get_output_details()\n",
        "\n",
        "# The quantization parameters tell us how to map float -> int8 and back.\n",
        "# quantization = (scale, zero_point)\n",
        "in_scale, in_zero = input_details[0][\"quantization\"]\n",
        "out_scale, out_zero = output_details[0][\"quantization\"]\n",
        "\n",
