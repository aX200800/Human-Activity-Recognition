      "source": [
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "\n",
        "# =========================\n",
        "# 1) Better accuracy config (still reasonable compute)\n",
        "# =========================\n",
        "WINDOW_SIZE = 128     # more context\n",
        "STRIDE = 64           # overlap improves accuracy\n",
        "PURITY = 0.7          # slightly more permissive to keep enough windows\n",
        "EPOCHS = 20\n",
        "BATCH_SIZE = 128\n",
        "\n",
        "# =========================\n",
        "# 2) Subject-independent split\n",
        "# =========================\n",
        "subjects = np.sort(accel_df[\"subject\"].unique())\n",
        "np.random.seed(42)\n",
        "np.random.shuffle(subjects)\n",
        "split = int(0.8 * len(subjects))\n",
        "train_subjects = subjects[:split]\n",
        "test_subjects  = subjects[split:]\n",
        "\n",
        "print(\"Train subjects:\", len(train_subjects), \"Test subjects:\", len(test_subjects))\n",
        "\n",
        "# =========================\n",
        "# 3) Windowing + add magnitude + jerk (cheap signal boost)\n",
        "# =========================\n",
        "def make_windows_with_extra_channels(df_s, window_size=128, stride=64, purity=0.7):\n",
        "    df_s = df_s.sort_values(\"timestamp\").reset_index(drop=True)\n",
        "    X_list, y_list = [], []\n",
        "    n = len(df_s)\n",
        "\n",
        "    for start in range(0, n - window_size + 1, stride):\n",
        "        w = df_s.iloc[start:start+window_size]\n",
        "        labels = w[\"activity\"].values\n",
        "\n",
        "        vals, counts = np.unique(labels, return_counts=True)\n",
        "        maj = vals[np.argmax(counts)]\n",
        "        maj_ratio = counts.max() / window_size\n",
        "        if maj_ratio < purity:\n",
        "            continue\n",
        "\n",
        "        ax = w[\"ax\"].to_numpy(dtype=np.float32)\n",
        "        ay = w[\"ay\"].to_numpy(dtype=np.float32)\n",
        "        az = w[\"az\"].to_numpy(dtype=np.float32)\n",
        "\n",
        "        acc_mag = np.sqrt(ax*ax + ay*ay + az*az).astype(np.float32)\n",
        "        jerk = np.diff(acc_mag, prepend=acc_mag[0]).astype(np.float32)\n",
        "\n",
        "        # Stack channels -> shape (T, 5)\n",
        "        arr = np.stack([ax, ay, az, acc_mag, jerk], axis=1)\n",
        "        X_list.append(arr)\n",
        "        y_list.append(maj)\n",
        "\n",
        "    if len(X_list) == 0:\n",
        "        return None, None\n",
        "    return np.stack(X_list), np.array(y_list)\n",
        "\n",
        "def window_all_subjects_extra(df, subjects, window_size=128, stride=64, purity=0.7):\n",
        "    X_all, y_all = [], []\n",
        "    for s in subjects:\n",
        "        df_s = df[df[\"subject\"] == s]\n",
        "        X_s, y_s = make_windows_with_extra_channels(df_s, window_size, stride, purity)\n",
        "        if X_s is None:\n",
        "            continue\n",
        "        X_all.append(X_s)\n",
        "        y_all.append(y_s)\n",
        "\n",
        "    X = np.concatenate(X_all, axis=0)\n",
        "    y = np.concatenate(y_all, axis=0)\n",
        "    return X, y\n",
        "\n",
        "X_train, y_train = window_all_subjects_extra(accel_df, train_subjects, WINDOW_SIZE, STRIDE, PURITY)\n",
        "X_test,  y_test  = window_all_subjects_extra(accel_df, test_subjects,  WINDOW_SIZE, STRIDE, PURITY)\n",
        "\n",
        "print(\"Train windows:\", X_train.shape, \"Test windows:\", X_test.shape)\n",
        "\n",
        "# =========================\n",
        "# 4) Encode labels (train-only)\n",
        "# =========================\n",
        "classes = np.unique(y_train)\n",
        "cls2id = {c:i for i,c in enumerate(classes)}\n",
        "id2cls = {i:c for c,i in cls2id.items()}\n",
        "\n",
        "y_train_id = np.array([cls2id[v] for v in y_train], dtype=np.int32)\n",
        "y_test_id  = np.array([cls2id[v] for v in y_test], dtype=np.int32)\n",
        "\n",
        "print(\"Num classes:\", len(classes), \"Classes:\", classes)\n",
        "\n",
        "# =========================\n",
        "# 5) Standardize using training stats\n",
        "# =========================\n",
        "mean = X_train.mean(axis=(0,1), keepdims=True)\n",
        "std  = X_train.std(axis=(0,1), keepdims=True) + 1e-8\n",
        "X_train_n = (X_train - mean) / std\n",
        "X_test_n  = (X_test  - mean) / std\n",
        "\n",
        "# =========================\n",
        "# 6) Class weights (helps rare classes)\n",
        "# =========================\n",
        "cw = compute_class_weight(class_weight=\"balanced\", classes=np.arange(len(classes)), y=y_train_id)\n",
        "class_weights = {i: float(w) for i, w in enumerate(cw)}\n",
        "print(\"Using class weights\")\n",
        "\n",
        "# =========================\n",
        "# 7) Small but stronger CNN (still mobile-friendly)\n",
        "#    - BatchNorm improves stability\n",
        "#    - SeparableConv1D keeps compute lower than standard conv\n",
        "# =========================\n",
        "def build_small_cnn(input_shape, num_classes):\n",
        "    inputs = tf.keras.Input(shape=input_shape)\n",
        "\n",
        "    x = tf.keras.layers.Conv1D(24, 7, padding=\"same\")(inputs)\n",
        "    x = tf.keras.layers.BatchNormalization()(x)\n",
        "    x = tf.keras.layers.ReLU()(x)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(48, 5, padding=\"same\")(x)\n",
        "    x = tf.keras.layers.BatchNormalization()(x)\n",
        "    x = tf.keras.layers.ReLU()(x)\n",
        "    x = tf.keras.layers.MaxPool1D(2)(x)\n",
        "\n",
        "    x = tf.keras.layers.SeparableConv1D(64, 3, padding=\"same\")(x)\n",
        "    x = tf.keras.layers.BatchNormalization()(x)\n",
        "    x = tf.keras.layers.ReLU()(x)\n",
        "\n",
        "    x = tf.keras.layers.GlobalAveragePooling1D()(x)\n",
        "    x = tf.keras.layers.Dropout(0.25)(x)\n",
        "\n",
        "    outputs = tf.keras.layers.Dense(num_classes, activation=\"softmax\")(x)\n",
        "\n",
        "    model = tf.keras.Model(inputs, outputs)\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(1e-3),\n",
        "        loss=\"sparse_categorical_crossentropy\",\n",
        "        metrics=[\"accuracy\"]\n",
        "    )\n",
        "    return model\n",
        "\n",
        "model = build_small_cnn((WINDOW_SIZE, X_train_n.shape[2]), len(classes))\n",
        "model.summary()\n",
        "print(\"Params:\", model.count_params())\n",
        "\n",
        "callbacks = [\n",
        "    tf.keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=4, restore_best_weights=True),\n",
        "    tf.keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=2, min_lr=1e-5)\n",
        "]\n",
        "\n",
        "history = model.fit(\n",
        "    X_train_n, y_train_id,\n",
        "    validation_split=0.15,\n",
        "    epochs=EPOCHS,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    class_weight=class_weights,\n",
        "    callbacks=callbacks,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# =========================\n",
        "# 8) Evaluate\n",
        "# =========================\n",
        "probs = model.predict(X_test_n, verbose=0)\n",
        "pred_id = np.argmax(probs, axis=1)\n",
        "y_pred = np.array([id2cls[i] for i in pred_id])\n",
        "\n",
        "acc = accuracy_score(y_test, y_pred)\n",
        "f1m = f1_score(y_test, y_pred, average=\"macro\")\n",
        "\n",
        "print(\"\\n===== Test Results (Subject-independent) =====\")\n",
        "print(\"Accuracy:\", acc)\n",
        "print(\"Macro-F1 :\", f1m)\n",
        "print(\"\\nReport:\\n\", classification_report(y_test, y_pred))\n"
      ],
